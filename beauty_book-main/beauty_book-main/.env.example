VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Apple Developer Maps token with the MapKit JS scope (not Embed API).
VITE_APPLE_MAPS_TOKEN=
# Public HTTPS application URL used by Supabase confirmation links in production.
VITE_PUBLIC_APP_URL=https://app.example.com
# Leave empty on web when /api is routed to the backend. Native builds require an HTTPS API URL.
VITE_BACKEND_URL=
VITE_ADMIN_URL=http://localhost:5174
VITE_SELLER_URL=http://localhost:5175
LOCAL_BACKEND_URL=http://127.0.0.1:3000

# Shopify Storefront API (the token is public/read-only)
VITE_SHOPIFY_DOMAIN=y904yr-0a.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional; defaults to the API version used by the current deployment.
VITE_SHOPIFY_API_VERSION=2026-07

# Netlify Functions can use these server-side names. They may also fall back
# to the VITE_* names when the same variables are configured in Netlify.
SHOPIFY_DOMAIN=y904yr-0a.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-07
