NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_CA_CERT=
# Local development only, when the Supabase pooler exposes a self-signed chain.
# Keep this unset/true in production; prefer DATABASE_CA_CERT when available.
DATABASE_SSL_REJECT_UNAUTHORIZED=false
OPENAI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
FAL_KEY=
ADMIN_REQUIRE_MFA=true
PUBLIC_API_URL=
APP_URL=http://localhost:5173
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
INTEGRATION_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Commerce multi-vendeurs : valeur obligatoire, exprimée en points de base.
# 100 = 1 %. À définir selon les conditions commerciales effectivement adoptées.
MARKETPLACE_COMMISSION_BPS=
SELLER_APP_URL=http://localhost:5175
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
XAI_IMAGE_MODEL=grok-imagine-image-2.0
AI_IMAGE_PROVIDER=grok
AI_IMAGE_DAILY_LIMIT=10
