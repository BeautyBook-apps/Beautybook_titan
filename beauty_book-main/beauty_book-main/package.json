{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:admin": "node ./node_modules/vite/bin/vite.js --config vite.admin.config.js",
    "dev:seller": "node ./node_modules/vite/bin/vite.js --config vite.seller.config.js",
    "dev:all": "concurrently -n app,admin,seller -c cyan,magenta,yellow \"npm run dev\" \"npm run dev:admin\" \"npm run dev:seller\"",
    "build": "node scripts/export-questionnaires.mjs && node ./node_modules/vite/bin/vite.js build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "open:app": "start http://localhost:5173/",
    "open:admin": "start http://localhost:5174/admin",
    "open:seller": "start http://localhost:5175/vendeur",
    "open:all": "start http://localhost:5173/ & start http://localhost:5174/admin & start http://localhost:5175/vendeur",
    "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:open": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "cap:build": "npm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "cap:sync:ios": "node node_modules/@capacitor/cli/bin/capacitor sync ios",
    "cap:open:ios": "node node_modules/@capacitor/cli/bin/capacitor open ios",
    "cap:build:ios": "npm run build && node node_modules/@capacitor/cli/bin/capacitor sync ios"
  },
